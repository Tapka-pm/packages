{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tapka package configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "versions"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "id": {
      "$ref": "#/$defs/packageId"
    },
    "versions": {
      "type": "object",
      "description": "Current releases of maintained release lines and their aliases. Resolve latest when an install request omits the version.",
      "required": ["latest"],
      "propertyNames": {
        "$ref": "#/$defs/versionName"
      },
      "properties": {
        "latest": {
          "$ref": "#/$defs/versionAlias",
          "description": "Alias for the latest release and the default version for installation."
        }
      },
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/packageVersion" },
          { "$ref": "#/$defs/versionAlias" }
        ]
      }
    }
  },
  "$defs": {
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "versionName": {
      "type": "string",
      "pattern": "\\S"
    },
    "versionAlias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "to"],
      "properties": {
        "type": {
          "const": "alias"
        },
        "to": {
          "$ref": "#/$defs/versionName",
          "description": "Version key in this package's versions object."
        }
      }
    },
    "packageVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "dependencies",
        "architectures"
      ],
      "properties": {
        "type": {
          "const": "package"
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/packageId" },
              { "$ref": "#/$defs/renamedDependency" }
            ]
          }
        },
        "architectures": {
          "type": "object",
          "description": "Available Windows targets for this release.",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "x64": {
              "$ref": "#/$defs/windowsTarget"
            },
            "arm64": {
              "$ref": "#/$defs/windowsTarget"
            }
          }
        }
      }
    },
    "renamedDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rename"],
      "properties": {
        "id": { "$ref": "#/$defs/packageId" },
        "rename": {
          "type": "object",
          "description": "Command names mapped to aliases in this package's dependency PATH.",
          "propertyNames": { "$ref": "#/$defs/commandName" },
          "additionalProperties": { "$ref": "#/$defs/commandName" }
        }
      }
    },
    "commandName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!.*[. ](?:[/\\\\]|$))[^/\\\\:\"<>|?*\\x00-\\x1f]+(?:[/\\\\][^/\\\\:\"<>|?*\\x00-\\x1f]+)*$",
      "description": "A relative Windows path whose segments do not end in a dot or space."
    },
    "windowsTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "install",
        "commands"
      ],
      "properties": {
        "download": {
          "type": "object",
          "description": "Upstream distribution. Draft configurations may omit this field until an artifact is available.",
          "additionalProperties": false,
          "required": ["url"],
          "oneOf": [
            { "required": ["sha256"] },
            { "required": ["sha512"] }
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^/\\s?#]+[^\\s]*$",
              "description": "HTTPS URL of the upstream distribution."
            },
            "sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "sha512": {
              "type": "string",
              "minLength": 128,
              "maxLength": 128,
              "pattern": "^[A-Fa-f0-9]{128}$"
            }
          }
        },
        "install": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "anyOf": [
            { "required": ["script"] },
            { "required": ["archive"] }
          ],
          "properties": {
            "type": {
              "const": "portable"
            },
            "script": {
              "$ref": "#/$defs/relativePath",
              "pattern": "\\.[pP][sS]1$",
              "description": "Path to the PowerShell 7 script, relative to the recipe directory. If archive is also specified, run the script after extraction."
            },
            "archive": {
              "enum": ["zip", "7z", "rar", "tar", "tar.gz", "tar.xz"],
              "description": "Extract the verified archive into the staging directory using the declared format."
            }
          }
        },
        "commands": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/commandName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/relativePath"
          },
          "description": "Command names mapped to executable paths inside the installed package."
        }
      }
    }
  }
}
