{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tapka package configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "dependencies",
    "architectures"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "id": {
      "$ref": "#/$defs/packageId"
    },
    "version": {
      "type": "string",
      "pattern": "\\S",
      "description": "Version of the current release."
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/packageId"
      }
    },
    "architectures": {
      "type": "object",
      "description": "Available Windows targets for this release.",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "x64": {
          "$ref": "#/$defs/windowsTarget"
        },
        "arm64": {
          "$ref": "#/$defs/windowsTarget"
        }
      }
    }
  },
  "$defs": {
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!.*[. ](?:[/\\\\]|$))[^/\\\\:\"<>|?*\\x00-\\x1f]+(?:[/\\\\][^/\\\\:\"<>|?*\\x00-\\x1f]+)*$",
      "description": "A relative Windows path whose segments do not end in a dot or space."
    },
    "windowsTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "install",
        "commands"
      ],
      "properties": {
        "download": {
          "type": "object",
          "description": "Upstream distribution. Draft configurations may omit this field until an artifact is available.",
          "additionalProperties": false,
          "required": ["url"],
          "oneOf": [
            { "required": ["sha256"] },
            { "required": ["sha512"] }
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^/\\s?#]+[^\\s]*$",
              "description": "HTTPS URL of the upstream distribution."
            },
            "sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            "sha512": {
              "type": "string",
              "minLength": 128,
              "maxLength": 128,
              "pattern": "^[A-Fa-f0-9]{128}$"
            }
          }
        },
        "install": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "oneOf": [
            { "required": ["script"] },
            { "required": ["archive"] }
          ],
          "properties": {
            "type": {
              "const": "portable"
            },
            "script": {
              "$ref": "#/$defs/relativePath",
              "pattern": "\\.[pP][sS]1$",
              "description": "Path to the PowerShell 7 script, relative to the recipe directory."
            },
            "archive": {
              "const": "zip",
              "description": "Extract the downloaded ZIP directly into the staging directory."
            }
          }
        },
        "commands": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/relativePath"
          },
          "description": "Command names mapped to executable paths inside the installed package."
        }
      }
    }
  }
}
